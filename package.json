{
  "name": "deep-500",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "catalog:demo": "node scripts/build-demo-catalog.mjs",
    "catalog:nasa": "node scripts/build-nasa-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:catalog:nasa": "node scripts/check-catalog.mjs --dataset=nasa",
    "check:editorial": "node scripts/check-editorial.mjs",
    "editorial:build": "node scripts/build-editorial.mjs",
    "prebuild": "npm run check:catalog && npm run check:editorial && npm run editorial:build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
